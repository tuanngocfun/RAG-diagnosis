# Dockerfile for compiling Master Thesis LaTeX
# Includes all required TeXLive packages for the thesis template
# 
# Build: docker build -t thesis-latex -f Dockerfile.thesis .
# Run:   docker run --rm -v "$(pwd)":/thesis thesis-latex
#
# Author: Auto-generated for Leishmania RAG Thesis Project

FROM ubuntu:22.04

LABEL maintainer="Leishmania RAG Thesis Project"
LABEL description="LaTeX compilation environment for master thesis"

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Install TeXLive and all required packages for thesis compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    make \
    ghostscript \
    # Core TeXLive
    texlive \
    texlive-base \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    # Fonts (required for ClassicThesis)
    texlive-fonts-recommended \
    texlive-fonts-extra \
    cm-super \
    # Language support
    texlive-lang-german \
    texlive-lang-english \
    # Bibliography support (BibLaTeX/Biber)
    texlive-bibtex-extra \
    biber \
    # Science/Math packages
    texlive-science \
    # Pictures and graphics
    texlive-pictures \
    texlive-pstricks \
    # Publishers (IEEE, ACM, etc.)
    texlive-publishers \
    # Additional utilities
    latexmk \
    chktex \
    # Clean up apt cache
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /thesis

# Default command: compile thesis with latexmk
CMD ["latexmk", "-pdf", "-interaction=nonstopmode", "-file-line-error", "thesis.tex"]
